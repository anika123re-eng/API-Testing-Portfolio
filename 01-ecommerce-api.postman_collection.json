  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set current timestamp in environment variable",
          "const now = new Date();",
          "",
          "// ISO 8601 format e.g. \"2026-11-07T14:18:00.000Z\"",
          "pm.environment.set(\"timestamp\", now.toISOString());",
          "",
          "// Unix timestamp in milliseconds e.g. 1762524000000",
          "pm.environment.set(\"timestamp_ms\", now.getTime());"
        ]
      }
    }
