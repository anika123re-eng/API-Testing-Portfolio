  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Log to console",
              "const envName = pm.environment.name || \"No environment selected\";",
              "console.log(\"Current Environment:\", envName);",
              "",
              "// Show in Visualize tab (response body)",
              "const template = `",
              "    <h2 style=\"font-family:sans-serif; color:#333;\">Current Environment</h2>",
              "    <p style=\"font-family:sans-serif; font-size:18px; color:#e74c3c;\"><strong>{{envName}}</strong></p>",
              "`;",
              "pm.visualizer.set(template, { envName: envName });",
              "",
              "// Also surface in test results",
              "pm.test(\"Environment: \" + envName, function () {",
              "    pm.expect(envName).to.not.be.empty;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
